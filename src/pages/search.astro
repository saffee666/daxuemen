---
import Layout from '../layouts/Layout.astro';
import PagefindSearch from '../components/site/PagefindSearch.astro';
import { loadSiteContent } from '../lib/content';

const { counts: data } = await loadSiteContent();
const suggestions = ['杭州', '学生票', '竞赛', '租房', '保研'];
---

<Layout
  title="搜索"
  description="全站全文搜索：校园门道、社会支持、攻略库。"
  indexable={false}
  ignore
>
  <div class="page-head search-head">
    <p class="eyebrow">搜索 · 全站</p>
    <h1>「三周前那条通知」一分钟找回。</h1>
    <p class="page-desc">
      在 {data.entries} 条条目与 {data.guides} 篇攻略里直接搜原文：输入地名、金额、证书名、坑的关键词都行。
      搜不到时，试试更短的关键词，或去对应的支柱页按分类筛选。
    </p>
    <div class="search-suggest" data-search-suggest>
      <span>试试：</span>
      {suggestions.map((s) => <button type="button" class="chip" data-term={s}>{s}</button>)}
    </div>
  </div>

  <div class="search-shell">
    <PagefindSearch />
    <noscript>
      <p class="search-fallback">搜索需要启用 JavaScript；你也可以直接浏览校园门道与社会支持。</p>
    </noscript>
    <div class="search-tips">
      <div>
        <h2>搜不到？</h2>
        <ul>
          <li>用更短的关键词：「杭州 租房」→「租房」。</li>
          <li>政策名记不全就搜动作：「怎么领」「截止」「材料」。</li>
          <li>直接翻支柱页：社会支持按补贴/优惠类型，校园门道按避坑/学习/生活/开源挣钱。</li>
        </ul>
      </div>
      <div>
        <h2>找不到想要的信息？</h2>
        <p>
          本站条目只覆盖已核对的内容；如果某个补贴/坑位缺失，欢迎
          <a href="/about#correction">爆料线索</a>告诉我们，附上官方原文链接最好。
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const mount = document.querySelector<HTMLElement>('[data-pf-mount]');

  const suggest = document.querySelector('[data-search-suggest]');
  suggest?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-term]');
    if (!button) return;
    const term = button.dataset.term ?? '';
    const ui = (window as any).__pagefindUI;
    if (ui && typeof ui.triggerSearch === 'function') {
      ui.triggerSearch(term);
    } else {
      const input = mount?.querySelector<HTMLInputElement>('input[type="search"], input');
      if (input) {
        input.value = term;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
    mount?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>

<style>
  .search-head {
    padding-bottom: 0;
  }

  .search-suggest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }

  .search-suggest .chip {
    cursor: pointer;
    font: inherit;
  }

  .search-shell {
    max-width: 780px;
    padding: 28px 0 60px;
  }

  .search-ui {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line-strong);
    --pagefind-ui-tag: var(--surface-soft, #efece3);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 10px;
    --pagefind-ui-font: var(--font);
  }

  .search-fallback {
    margin-top: 18px;
    padding: 12px 14px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: 0.86rem;
  }

  .search-tips {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .search-tips h2 {
    margin: 0 0 8px;
    font-size: 0.95rem;
  }

  .search-tips ul {
    margin: 0;
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .search-tips p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .search-tips {
      grid-template-columns: 1fr;
    }
  }
</style>
