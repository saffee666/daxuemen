---
import { MONEY_PILLARS, DAO_PILLARS } from '../../lib/pillars';
import { SITE } from '../../lib/site';
import { url } from '../../lib/url';

interface Props {
  pathname?: string;
}
const { pathname = Astro.url.pathname } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stripped = base && pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
const here = stripped || '/';

const isMoney = here === '/money' || here.startsWith('/money/');
const isDao = here === '/dao' || here.startsWith('/dao/');
const isGuides = here === '/guides' || here.startsWith('/guides/');
// 信息差工具层 = tools + radar（时间线提醒是工具层的一件）
const isTools = here === '/tools' || here.startsWith('/tools/') || here === '/radar' || here.startsWith('/radar/');
const isAbout = here === '/about';

const money = Object.values(MONEY_PILLARS);
const dao = Object.values(DAO_PILLARS);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url('/')} aria-label={`${SITE.name}首页`}>
      <svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="13" stroke="currentColor" stroke-width="1.6" opacity="0.28" />
        <circle cx="16" cy="16" r="8" stroke="currentColor" stroke-width="1.6" opacity="0.55" />
        <path d="M16 16V3" stroke="currentColor" stroke-width="1.6" />
        <path d="M16 16l9.2-9.2" stroke="currentColor" stroke-width="1.6" opacity="0.5" />
        <circle cx="16" cy="16" r="2.6" fill="currentColor" />
        <circle cx="24" cy="8" r="1.8" fill="currentColor" />
      </svg>
      <span>{SITE.name}</span>
    </a>

    <nav class="primary-nav" aria-label="主导航">
      <details class="nav-menu">
        <summary data-current={isDao ? 'true' : undefined}>
          校园门道
          <svg class="nav-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav-panel">
          {dao.map((p) => (
            <a href={url(`/dao/${p.key}`)}>
              {p.num} {p.name}
              <span class="panel-note">{p.short}</span>
            </a>
          ))}
          <a class="panel-all" href={url('/dao/pits')}>先看避坑 →</a>
        </div>
      </details>

      <details class="nav-menu">
        <summary data-current={isMoney ? 'true' : undefined}>
          社会支持
          <svg class="nav-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav-panel">
          {money.map((p) => (
            <a href={url(`/money/${p.key}`)}>
              {p.num} {p.name}
              <span class="panel-note">{p.short}</span>
            </a>
          ))}
          <a class="panel-all" href={url('/money/gov')}>从政府的钱开始 →</a>
        </div>
      </details>

      <details class="nav-menu">
        <summary data-current={isTools ? 'true' : undefined}>
          信息差工具
          <svg class="nav-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav-panel">
          <a href={url('/tools/wizard')}>
            我能领什么
            <span class="panel-note">三步自查，本地计算</span>
          </a>
          <a href={url('/tools/auth')}>
            认证导航
            <span class="panel-note">各平台学生认证入口</span>
          </a>
          <a href={url('/tools/stacking')}>
            叠加逻辑
            <span class="panel-note">教育优惠 × 国补 × 平台券</span>
          </a>
          <a href={url('/tools/decide')}>
            留大城市还是回老家
            <span class="panel-note">去向决策框架</span>
          </a>
          <a href={url('/radar')}>
            雷达 · 时间线提醒
            <span class="panel-note">新发生的增量情报</span>
          </a>
          <a class="panel-all" href={url('/tools')}>全部工具 →</a>
        </div>
      </details>

      <a class="nav-link" href={url('/guides')} aria-current={isGuides ? 'page' : undefined}>攻略</a>
      <a class="nav-link" href={url('/about')} aria-current={isAbout ? 'page' : undefined}>关于</a>

      <a class="nav-search" href={url('/search')} aria-label="搜索全站">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.8" stroke="currentColor" stroke-width="1.5" />
          <path d="m10.6 10.6 3.2 3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </a>
    </nav>

    <details class="mobile-menu">
      <summary>
        菜单
        <svg class="nav-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="mobile-panel">
        <a href={url('/')}>首页</a>
        <span class="group-label">校园门道</span>
        {dao.map((p) => <a href={url(`/dao/${p.key}`)}>{p.num} {p.name}</a>)}
        <span class="group-label">社会支持</span>
        {money.map((p) => <a href={url(`/money/${p.key}`)}>{p.num} {p.name}</a>)}
        <span class="group-label">信息差工具</span>
        <a href={url('/tools/wizard')}>我能领什么</a>
        <a href={url('/tools/auth')}>认证导航</a>
        <a href={url('/tools/stacking')}>叠加逻辑</a>
        <a href={url('/tools/decide')}>留大城市还是回老家</a>
        <a href={url('/radar')}>雷达 · 时间线提醒</a>
        <span class="group-label">更多</span>
        <a href={url('/guides')}>攻略库</a>
        <a href={url('/tools')}>工具总览</a>
        <a href={url('/search')}>搜索全站</a>
        <a href={url('/about')}>关于与纠错</a>
      </div>
    </details>
  </div>
</header>
