---
import { MONEY_PILLARS, DAO_PILLARS } from '../../lib/pillars';
import { SITE } from '../../lib/site';
import { url } from '../../lib/url';
import { loadSiteContent } from '../../lib/content';

const { lastVerified, counts } = await loadSiteContent();
const year = new Date().getFullYear();
const money = Object.values(MONEY_PILLARS);
const dao = Object.values(DAO_PILLARS);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={url('/')}>
          <svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="16" r="13" stroke="currentColor" stroke-width="1.6" opacity="0.28" />
            <circle cx="16" cy="16" r="8" stroke="currentColor" stroke-width="1.6" opacity="0.55" />
            <path d="M16 16V3" stroke="currentColor" stroke-width="1.6" />
            <circle cx="16" cy="16" r="2.6" fill="currentColor" />
          </svg>
          <span>{SITE.name}</span>
        </a>
        <p class="footer-tagline">{SITE.tagline}</p>
        <p class="footer-tagline" style="margin-top:8px;font-size:.8rem">
          {counts.entries} 条门道 · {counts.guides} 篇攻略 · 最后核对 {lastVerified}
        </p>
      </div>

      <div class="footer-col">
        <h3>社会支持</h3>
        {money.map((p) => <a href={url(`/money/${p.key}`)}>{p.name}</a>)}
      </div>

      <div class="footer-col">
        <h3>校园门道</h3>
        {dao.map((p) => <a href={url(`/dao/${p.key}`)}>{p.name}</a>)}
      </div>

      <div class="footer-col">
        <h3>更多</h3>
        <a href={url('/radar')}>校园信息雷达</a>
        <a href={url('/guides')}>攻略库</a>
        <a href={url('/search')}>搜索全站</a>
        <a href={url('/about')}>关于 · 核对机制</a>
        <a href={url('/corrections')}>纠错日志</a>
        <a href={url('/editorial')}>编辑政策</a>
        <a href={url('/how-we-build')}>目录方法论</a>
        <a href={url('/privacy')}>隐私说明</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.name}</span>
      <span>非官方信息整理 · 政策与价格以官方渠道为准 · 过期条目不删除，只标记</span>
    </div>
  </div>
</footer>
