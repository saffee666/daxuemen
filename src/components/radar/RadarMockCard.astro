---
// 静态界面示意：完全虚构，不读取任何真实数据
---

<div class="mock-app" aria-hidden="true">
  <div class="mock-top">
    <span class="mock-avatar">示</span>
    <div>
      <div class="mock-title">群务台</div>
      <div class="mock-sub">3 个群 · 演示账号</div>
    </div>
    <span class="mock-live">在线</span>
  </div>

  <div class="mock-kpis">
    <div class="mock-kpi alert"><b>2</b><span>今天截止</span></div>
    <div class="mock-kpi"><b>5</b><span>本周待办</span></div>
    <div class="mock-kpi"><b>12</b><span>已归档</span></div>
  </div>

  <div class="mock-tabs">
    <span class="mock-tab active">待办</span>
    <span class="mock-tab">收件箱</span>
    <span class="mock-tab">日历</span>
    <span class="mock-tab">设置</span>
  </div>

  <div class="mock-list">
    <div class="mock-task">
      <span class="mock-check"></span>
      <div class="mock-task-main">
        <div class="mock-task-title">国家励志奖学金材料提交</div>
        <div class="mock-task-meta">年级通知群 · 成绩单 + 申请表</div>
      </div>
      <span class="mock-deadline">今天</span>
    </div>
    <div class="mock-task">
      <span class="mock-check"></span>
      <div class="mock-task-main">
        <div class="mock-task-title">杭州应届生生活补贴申报</div>
        <div class="mock-task-meta">就业群 · 需劳动合同与社保</div>
      </div>
      <span class="mock-deadline">3 天</span>
    </div>
    <div class="mock-task">
      <span class="mock-check"></span>
      <div class="mock-task-main">
        <div class="mock-task-title">互联网+ 校赛报名</div>
        <div class="mock-task-meta">竞赛群 · 组队表已发群文件</div>
      </div>
      <span class="mock-deadline calm">7 天</span>
    </div>
  </div>

  <div class="mock-foot">演示数据 · 非真实群消息</div>
</div>
