---
import type { AnyEntry } from '../../lib/content';
import { entryPath } from '../../lib/url';
import { ALL_PILLARS } from '../../lib/pillars';

interface Props {
  entries: AnyEntry[];
  title?: string;
}

const { entries, title = '相关条目' } = Astro.props;
---

{entries.length > 0 && (
  <section class="section-block">
    <div class="section-block-head">
      <span class="section-block-num" aria-hidden="true">↗</span>
      <h2>{title}</h2>
    </div>
    <div class="related-grid">
      {entries.map((entry) => {
        const pillar = ALL_PILLARS[entry.data.pillar];
        return (
          <a class="related-item" href={entryPath(entry.id)}>
            <span class="related-title">{entry.data.title}</span>
            <span class="related-meta">
              {pillar?.name ?? entry.data.pillar} · {entry.data.region} · 核对 {entry.data.verified_date}
            </span>
          </a>
        );
      })}
    </div>
  </section>
)}
