---
// 价格走势（构建时渲染，零客户端 JS）。
// 零件来源：_素材/复刻/_原子/会员比比 price-watch/chart，Astro 化改写，语义 token 供货。
import type { PriceStats } from '../../lib/pricing';

interface Props {
  stats: PriceStats;
}
const { stats } = Astro.props;
const { points, current, lowest, isLowest, monthly } = stats;
const W = 640;
const H = 160;
const PAD = 34;
const prices = points.map((p) => p.price);
const min = Math.min(...prices);
const max = Math.max(...prices);
const span = max - min || 1;
const step = points.length > 1 ? (W - PAD * 2) / (points.length - 1) : 0;
const y = (p: number) => H - PAD - ((p - min) / span) * (H - PAD * 2);
const fmt = (n: number) => (n === 0 ? '免费' : `¥${n}`);
const tail = (cur: (typeof points)[number]) =>
  (monthly
    ? monthly.price === 0
      ? ' · 免费'
      : ` · 折合 ¥${(monthly.price / monthly.months).toFixed(1)}/月`
    : '') + (cur.note ? ` · ${cur.note}` : '');
---

<div class="price-trend">
  {points.length >= 2 && (
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="历次核对价格走势图">
      <polyline points={points.map((p, i) => `${PAD + i * step},${y(p.price).toFixed(1)}`).join(' ')} />
      {points.map((p, i) => (
        <g>
          <circle
            cx={PAD + i * step}
            cy={y(p.price)}
            r={p === current ? 5 : 3.5}
            class={p.price === lowest?.price ? 'low' : ''}
          />
          <text x={PAD + i * step} y={y(p.price) - 10} text-anchor="middle">{fmt(p.price)}</text>
          <text x={PAD + i * step} y={H - 8} text-anchor="middle">{p.date}</text>
        </g>
      ))}
    </svg>
  )}
  <p class="trend-note">
    {points.length} 次记价 · 起 {points[0].date} ·{' '}
    {isLowest ? '✅ 当前价格 = 本站记录的最低价' : `⚠️ 当前价高于最低 ${fmt(lowest!.price)}（${lowest!.date}）`}
    {tail(current!)}
  </p>
</div>
