---
interface Props {
  num: string;
  title: string;
}

const { num, title } = Astro.props;
---

<section class="section-block">
  <div class="section-block-head">
    <span class="section-block-num" aria-hidden="true">{num}</span>
    <h2>{title}</h2>
  </div>
  <div class="block-body">
    <slot />
  </div>
</section>
